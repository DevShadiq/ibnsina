PORT=3003
HOST=0.0.0.0
NODE_ENV=development

# Use the pooled Neon connection string (hostname normally contains -pooler)
# and keep sslmode=require. POSTGRES_URL is also accepted when a Vercel
# integration supplies that name instead.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
FRONTEND_ORIGIN=http://localhost:5173

# Optional location of a production Vue build. When omitted, the backend uses
# ../frontend/dist relative to this backend directory.
FRONTEND_DIST=
